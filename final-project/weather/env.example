# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Security
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///weather.db

# OpenWeatherMap API
WEATHER_API_KEY=your-api-key-here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=weather.log 